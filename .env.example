# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Naver Blog Account
NAVER_ID=your_naver_id
NAVER_PW=your_naver_password
NAVER_BLOG_URL=your_blog_id

# Tistory Blog Account (Optional)
# 티스토리는 카카오 계정으로 로그인합니다
KAKAO_ID=your_kakao_email@example.com
KAKAO_PASSWORD=your_kakao_password

# 티스토리 블로그 URL (필수)
TISTORY_BLOG_URL=https://yourblog.tistory.com

# Logging
LOG_LEVEL=INFO

# Scheduler
SCHEDULE_TIME=08:00

# 브라우저 설정 (Selenium)
HEADLESS=False

# Selenium WebDriver 대기 시간 (초)
WAIT_TIME=10
